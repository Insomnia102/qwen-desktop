{
  "name": "qwen-desktop",
  "version": "1.0.0",
  "description": "A community desktop interface for Qwen Code",
  "license": "GPL-3.0-only",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:ci": "tsc -p tsconfig.ci.json",
    "check:ci": "node scripts/ci-check.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir --publish never",
    "build:win": "pnpm run build && electron-builder --win --x64 --publish never",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:linux": "pnpm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@qwen-code/sdk": "0.1.32",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "marked": "18.2.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "31.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.18.0"
}
